# LITA provider routing
# round-robin rotates the first provider attempted on each request inside a warm
# function instance. ordered always starts with AI_PROVIDER_ORDER.
AI_PROVIDER_STRATEGY=round-robin
AI_PROVIDER_ORDER=gateway,groq,openrouter,nvidia,google
AI_PROVIDER_TIMEOUT_MS=12000

# Keep free-tier prompts small enough to avoid burning quotas.
LITA_MAX_OUTPUT_TOKENS=700
LITA_MAX_HISTORY_MESSAGES=20
LITA_MAX_CONTEXT_CHARS=24000

# Parent applications allowed to push financial context into the LITA iframe.
NEXT_PUBLIC_LITA_PARENT_ORIGINS=https://lleva-tus-cuentas.netlify.app,http://localhost:3000

# Vercel AI Gateway
# On Vercel, VERCEL_OIDC_TOKEN is used automatically when AI_GATEWAY_API_KEY is
# not set. Always choose model IDs from the current Vercel AI Gateway catalog.
AI_GATEWAY_MODEL=
AI_GATEWAY_FALLBACK_MODELS=
# AI_GATEWAY_API_KEY=

# Groq — OpenAI-compatible
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter — OpenAI-compatible
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_REFERER=https://lleva-tus-cuentas.netlify.app
OPENROUTER_APP_NAME=LITA

# NVIDIA NIM — OpenAI-compatible evaluation endpoint
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Google AI Studio — OpenAI-compatible Gemini endpoint
GEMINI_API_KEY=
GEMINI_MODEL=

# Backward compatibility with the previous two-provider setup.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
